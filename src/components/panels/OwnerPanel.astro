  });

  // 6. MODAL TÁCTIL: AGENDAR CITA MANUAL (GERENCIA)
  const ombModal = document.getElementById('owner-manual-book-modal');
  const ombBarberInput = document.getElementById('omb-barbero-id');
  const ombSrvInput = document.getElementById('omb-servicio-id');
  const ombFechaInput = document.getElementById('omb-fecha');
  const ombBloqueInput = document.getElementById('omb-bloque');
  const ombPagoInput = document.getElementById('omb-pago');
  const ombSlotsContainer = document.getElementById('omb-slots-container');
  const ombFeedback = document.getElementById('omb-feedback');

  async function loadOmbSlots() {
    if (!ombSlotsContainer || !ombBarberInput || !ombFechaInput) return;
    const bId = ombBarberInput.value;
    const fec = ombFechaInput.value;
    ombSlotsContainer.innerHTML = `<div class="col-span-3 py-2 text-center text-xs text-[#9A9AA6]">Cargando horarios...</div>`;
    const res = await fetch(`/api/public/disponibilidad?barbero_id=${encodeURIComponent(bId)}&fecha=${encodeURIComponent(fec)}`);
    const data = await res.json();
    const detalle = data.detalle || [];
    ombSlotsContainer.innerHTML = '';
    ombBloqueInput.value = '';

    detalle.forEach((slot) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.disabled = !slot.disponible;
      btn.className = slot.disponible
        ? 'omb-slot-btn min-h-[40px] rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2 px-2 font-mono text-xs font-bold text-[#F4F4F6]'
        : 'min-h-[40px] rounded-xl border border-[#23232C]/40 bg-[#0B0B0E]/40 py-2 px-2 font-mono text-xs text-[#9A9AA6] line-through opacity-40 cursor-not-allowed';
      btn.textContent = format12h(slot.hora);
      if (slot.disponible) {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.omb-slot-btn').forEach((b) => {
            b.className = 'omb-slot-btn min-h-[40px] rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2 px-2 font-mono text-xs font-bold text-[#F4F4F6]';
          });
          btn.className = 'omb-slot-btn min-h-[40px] rounded-xl border border-[#D4AF37] bg-[#D4AF37]/20 py-2 px-2 font-mono text-xs font-bold text-[#D4AF37]';
          ombBloqueInput.value = slot.hora;
        });
      }
      ombSlotsContainer.appendChild(btn);
    });
  }

  document.getElementById('open-owner-manual-book-btn')?.addEventListener('click', () => {
    loadOmbSlots();
    ombModal?.classList.remove('hidden');
    ombModal?.classList.add('flex');
  });

  document.getElementById('close-owner-manual-book')?.addEventListener('click', () => {
    ombModal?.classList.add('hidden');
    ombModal?.classList.remove('flex');
  });

  document.querySelectorAll('.omb-barber-card').forEach((card) => {
