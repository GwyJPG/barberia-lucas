      document.querySelectorAll('.omb-barber-card').forEach((c) => {
        c.className = 'omb-barber-card min-h-[42px] rounded-xl border border-[#23232C] bg-[#0B0B0E] p-2.5 text-xs font-bold text-[#F4F4F6] transition-all';
      });
      card.className = 'omb-barber-card min-h-[42px] rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 p-2.5 text-xs font-bold text-[#D4AF37] transition-all';
      ombBarberInput.value = card.getAttribute('data-omb-barber') || '';
      loadOmbSlots();
    });
  });

  document.querySelectorAll('.omb-srv-card').forEach((card) => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.omb-srv-card').forEach((c) => {
        c.className = 'omb-srv-card rounded-xl border border-[#23232C] bg-[#0B0B0E] p-2.5 text-left text-[#9A9AA6] transition-all';
      });
      card.className = 'omb-srv-card rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 p-2.5 text-left text-[#F4F4F6] transition-all';
      ombSrvInput.value = card.getAttribute('data-omb-srv') || '1';
    });
  });

  document.querySelectorAll('.omb-date-card').forEach((card) => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.omb-date-card').forEach((c) => {
        c.className = 'omb-date-card flex flex-col items-center rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2 px-1 text-center text-[#9A9AA6]';
      });
      card.className = 'omb-date-card flex flex-col items-center rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 py-2 px-1 text-center text-[#F4F4F6]';
      ombFechaInput.value = card.getAttribute('data-omb-date') || '';
      loadOmbSlots();
    });
  });

  document.querySelectorAll('.omb-pay-card').forEach((card) => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.omb-pay-card').forEach((c) => {
        c.className = 'omb-pay-card min-h-[40px] rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2 text-xs font-bold text-[#F4F4F6]';
      });
      card.className = 'omb-pay-card min-h-[40px] rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 py-2 text-xs font-bold text-[#D4AF37]';
      ombPagoInput.value = card.getAttribute('data-omb-pay') || 'efectivo';
    });
  });

  document.getElementById('owner-manual-book-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!ombBloqueInput.value) {
      if (ombFeedback) {
        ombFeedback.className = 'rounded-xl border border-[#EF4444]/40 bg-[#EF4444]/10 px-3.5 py-2.5 text-xs text-[#EF4444]';
        ombFeedback.textContent = 'Selecciona un horario disponible.';
        ombFeedback.classList.remove('hidden');
      }
      return;
    }

    const dni = document.getElementById('omb-dni').value.trim();
    const telefono = document.getElementById('omb-telefono').value.trim();
    const nombre_completo = document.getElementById('omb-nombre').value.trim();

    const res = await fetch('/api/owner/gestion', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        accion: 'agendar_manual',
        barbero_id: ombBarberInput.value,
        servicio_id: Number(ombSrvInput.value),
        fecha: ombFechaInput.value,
        bloque_horario: ombBloqueInput.value,
        dni,
        telefono,
        nombre_completo,
        metodo_pago: ombPagoInput.value,
      }),
    });
    const data = await res.json();
    if (!res.ok || !data.exito) {
      if (ombFeedback) {
        ombFeedback.className = 'rounded-xl border border-[#EF4444]/40 bg-[#EF4444]/10 px-3.5 py-2.5 text-xs text-[#EF4444]';
        ombFeedback.textContent = data.error || 'Error al agendar cita.';
        ombFeedback.classList.remove('hidden');
      }
      return;
    }
    window.location.reload();
  });

  // 7. MODAL TÁCTIL DE REPROGRAMACIÓN
  const reassignModal = document.getElementById('reassign-modal');
  const reassignCitaId = document.getElementById('reassign-cita-id');
  const reassignBarbero = document.getElementById('reassign-barbero');
  const reassignFecha = document.getElementById('reassign-fecha');
  const reassignBloque = document.getElementById('reassign-bloque');
  const modalSlotsContainer = document.getElementById('modal-slots-container');
  const reassignFeedback = document.getElementById('reassign-feedback');

  function highlightModalBarber(bId) {
    document.querySelectorAll('.modal-barber-card').forEach((card) => {
      if (card.getAttribute('data-modal-barber') === bId) {
        card.className = 'modal-barber-card min-h-[44px] rounded-xl border border-[#D4AF37] bg-[#D4AF37]/20 p-2.5 text-xs font-bold text-[#D4AF37] transition-all';
      } else {
        card.className = 'modal-barber-card min-h-[44px] rounded-xl border border-[#23232C] bg-[#0B0B0E] p-2.5 text-xs font-bold text-[#F4F4F6] transition-all';
      }
    });
  }

  function highlightModalDate(iso) {
    document.querySelectorAll('.modal-date-card').forEach((card) => {
      if (card.getAttribute('data-modal-date') === iso) {
        card.className = 'modal-date-card flex flex-col items-center rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 py-2 px-1 text-center text-[#F4F4F6]';
      } else {
        card.className = 'modal-date-card flex flex-col items-center rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2 px-1 text-center text-[#9A9AA6]';
      }
    });
  }

  async function loadModalSlots() {
    const bId = reassignBarbero?.value;
    const fec = reassignFecha?.value;
    if (!bId || !fec || !modalSlotsContainer) return;

    modalSlotsContainer.innerHTML = `<div class="col-span-3 py-3 text-center text-xs text-[#9A9AA6]">Cargando horarios...</div>`;
    const res = await fetch(`/api/public/disponibilidad?barbero_id=${encodeURIComponent(bId)}&fecha=${encodeURIComponent(fec)}`);
    const data = await res.json();
    const detalle = data.detalle || [];
    modalSlotsContainer.innerHTML = '';

    detalle.forEach((slot) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      const isCurrent = reassignBloque.value === slot.hora;
      const canPick = slot.disponible || isCurrent;

      btn.disabled = !canPick;
      btn.className = canPick
        ? `modal-slot-btn min-h-[42px] rounded-xl border py-2.5 px-2 font-mono text-xs font-bold transition-all ${
            isCurrent
              ? 'border-[#D4AF37] bg-[#D4AF37]/20 text-[#D4AF37]'
              : 'border-[#23232C] bg-[#0B0B0E] text-[#F4F4F6]'
          }`
        : 'min-h-[42px] rounded-xl border border-[#23232C]/40 bg-[#0B0B0E]/40 py-2.5 px-2 font-mono text-xs text-[#9A9AA6] line-through opacity-40 cursor-not-allowed';

      btn.textContent = format12h(slot.hora);
      if (canPick) {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.modal-slot-btn').forEach((b) => {
            b.className = 'modal-slot-btn min-h-[42px] rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2.5 px-2 font-mono text-xs font-bold text-[#F4F4F6]';
          });
          btn.className = 'modal-slot-btn min-h-[42px] rounded-xl border border-[#D4AF37] bg-[#D4AF37]/20 py-2.5 px-2 font-mono text-xs font-bold text-[#D4AF37]';
          reassignBloque.value = slot.hora;
        });
      }
      modalSlotsContainer.appendChild(btn);
    });
  }

  document.querySelectorAll('.open-reassign-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      reassignCitaId.value = btn.getAttribute('data-cita-id') || '';
      const bId = btn.getAttribute('data-barbero-id') || '';
      const f = btn.getAttribute('data-fecha') || '';
      const b = btn.getAttribute('data-bloque') || '';
      reassignBarbero.value = bId;
      reassignFecha.value = f;
      reassignBloque.value = b;
      const clientLabel = document.getElementById('reassign-client-label');
      if (clientLabel) clientLabel.textContent = `Cliente: ${btn.getAttribute('data-cliente')}`;
      highlightModalBarber(bId);
      highlightModalDate(f);
      loadModalSlots();
      reassignModal?.classList.remove('hidden');
      reassignModal?.classList.add('flex');
    });
  });

  document.querySelectorAll('.modal-barber-card').forEach((card) => {
    card.addEventListener('click', () => {
      const bId = card.getAttribute('data-modal-barber') || '';
      reassignBarbero.value = bId;
      highlightModalBarber(bId);
      loadModalSlots();
    });
