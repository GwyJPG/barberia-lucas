                                  <span class={`rounded-md px-2 py-0.5 text-[10px] font-bold uppercase ${
                                    citaSlot.estado === 'completada'
                                      ? 'bg-[#10B981]/20 text-[#10B981]'
                                      : citaSlot.estado === 'aceptada'
                                      ? 'bg-[#D4AF37]/20 text-[#D4AF37]'
                                      : 'bg-[#F59E0B]/20 text-[#F59E0B]'
                                  }`}>
                                    {citaSlot.estado}
                                  </span>
                                </div>

                                <p class="mt-2 font-serif text-sm font-bold text-[#F4F4F6]">
                                  {citaSlot.nombre_completo}
                                </p>
                                <p class="font-mono text-[11px] text-[#9A9AA6]">
                                  DNI: {citaSlot.dni} • Cel: {citaSlot.telefono}
                                </p>
                                <p class="mt-1 text-xs font-semibold text-[#D4AF37]">
                                  {citaSlot.servicios?.nombre || 'Corte'} • S/ {Number(citaSlot.precio_pactado).toFixed(2)} ({pagoTag})
                                </p>
                              </div>

                              <!-- Botones Táctiles Directos en el Calendario -->
                              <div class="mt-3 grid grid-cols-2 gap-1.5 border-t border-[#23232C] pt-2.5">
                                {citaSlot.estado === 'pendiente' && (
                                  <button
                                    type="button"
                                    class="owner-status-btn col-span-2 inline-flex min-h-[38px] items-center justify-center gap-1.5 rounded-lg bg-[#D4AF37] px-3 py-2 text-xs font-bold text-[#0B0B0E] active:scale-95"
                                    data-cita-id={citaSlot.id}
                                    data-estado="aceptada"
                                  >
                                    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                    <span>Aprobar Turno</span>
                                  </button>
                                )}
                                {['pendiente', 'aceptada'].includes(citaSlot.estado) && (
                                  <>
                                    <button
                                      type="button"
                                      class="owner-status-btn inline-flex min-h-[38px] items-center justify-center gap-1 rounded-lg bg-[#10B981] px-2.5 py-2 text-xs font-bold text-[#0B0B0E] active:scale-95"
                                      data-cita-id={citaSlot.id}
                                      data-estado="completada"
                                    >
                                      <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                      <span>Completar</span>
                                    </button>
                                    <button
                                      type="button"
                                      class="open-reassign-btn inline-flex min-h-[38px] items-center justify-center gap-1 rounded-lg border border-[#D4AF37]/40 bg-[#D4AF37]/10 px-2.5 py-2 text-xs font-bold text-[#D4AF37] active:scale-95"
                                      data-cita-id={citaSlot.id}
                                      data-barbero-id={citaSlot.barbero_id}
                                      data-fecha={citaSlot.fecha}
                                      data-bloque={citaSlot.bloque_horario}
                                      data-cliente={citaSlot.nombre_completo}
                                    >
                                      <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                                      <span>Reprogramar</span>
                                    </button>
                                    <button
                                      type="button"
                                      class="owner-status-btn inline-flex min-h-[38px] items-center justify-center gap-1 rounded-lg border border-[#EF4444]/40 bg-[#EF4444]/10 px-2.5 py-2 text-xs font-bold text-[#EF4444] active:scale-95"
                                      data-cita-id={citaSlot.id}
                                      data-estado="cancelada"
                                    >
                                      <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                      <span>Rechazar</span>
                                    </button>
                                  </>
                                )}
                                {d.iso === todayLima && ['pendiente', 'aceptada'].includes(citaSlot.estado) && (
                                  <a
                                    href={waAviso30mUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="col-span-2 flex min-h-[36px] items-center justify-center gap-1.5 rounded-lg border border-[#D4AF37]/50 bg-[#D4AF37]/10 px-2 py-1.5 text-xs font-bold text-[#D4AF37] hover:bg-[#D4AF37]/20 active:scale-95 transition-all"
                                    title="Avisar al cliente que en 30 minutos le toca su turno"
                                  >
                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                    <span>Avisar turno (en 30m)</span>
                                  </a>
                                )}
                                <a
                                  href={waUrl}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="flex min-h-[38px] items-center justify-center rounded-lg border border-[#10B981]/40 bg-[#10B981]/10 px-2.5 py-2 text-xs font-bold text-[#10B981]"
                                >
                                  WhatsApp
                                </a>
                              </div>
                            </div>
                          );
                        }

                        if (bloqueoSlot) {
                          return (
                            <div class="flex flex-col justify-between rounded-xl border border-[#F59E0B]/30 bg-[#141419]/60 p-3.5">
                              <div>
                                <div class="flex items-center justify-between">
                                  <span class="font-mono text-sm font-bold text-[#9A9AA6] line-through">
                                    {formatHora12(hora)}
                                  </span>
                                  <span class="rounded-md bg-[#F59E0B]/15 px-2 py-0.5 text-[10px] font-bold uppercase text-[#F59E0B]">
                                    Bloqueado
                                  </span>
                                </div>
                                <p class="mt-2 text-xs text-[#9A9AA6]">
                                  {bloqueoSlot.motivo || 'Descanso programado'}
                                </p>
                              </div>
                              <a
                                href={`https://wa.me/${whatsappSoporte}?text=${encodeURIComponent(`Hola Soporte, solicito desbloquear el turno de ${barbero.nombre_visible} del ${d.iso} (${hora}).`)}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-3 flex min-h-[36px] items-center justify-center rounded-lg border border-[#23232C] bg-[#0B0B0E] text-[11px] font-semibold text-[#D4AF37]"
