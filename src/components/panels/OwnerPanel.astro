            </div>
          ) : (
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {historialGeneralClientes.map((cl) => {
                const telClean = String(cl.telefono || '').replace(/\D/g, '');
                const waUrl = `https://wa.me/${telClean.startsWith('51') ? telClean : '51' + telClean}?text=${encodeURIComponent(`Hola ${cl.nombre_completo}, te saludamos de Barbería Lucas.`)}`;

                return (
                  <div class="flex flex-col justify-between rounded-2xl border border-[#23232C] bg-[#0B0B0E] p-4 shadow-md">
                    <div>
                      <div class="flex items-start justify-between gap-2 border-b border-[#23232C] pb-3">
                        <div>
                          <h3 class="font-serif text-base font-bold text-[#F4F4F6]">
                            {cl.nombre_completo}
                          </h3>
                          <p class="font-mono text-xs text-[#9A9AA6]">
                            DNI: {cl.dni} • Cel: {cl.telefono}
                          </p>
                        </div>
                        <span class="rounded-lg bg-[#D4AF37]/15 px-2.5 py-1 font-mono text-[10px] font-bold text-[#D4AF37]">
                          Última: {cl.ultima_fecha}
                        </span>
                      </div>

                      <div class="my-3.5 grid grid-cols-3 gap-2 text-center">
                        <div class="rounded-xl border border-[#23232C] bg-[#141419] p-2.5">
