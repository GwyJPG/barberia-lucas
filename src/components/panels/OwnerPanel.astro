---
import Layout from '../../layouts/Layout.astro';
import BrandLogo from '../brand/BrandLogo.astro';
import { supabaseAdmin } from '../../lib/supabaseServer';
import { getLimaDateTime } from '../../lib/rateLimit';

interface Props {
  user: any;
  rol: string;
  nombreVisible: string;
}

const { user } = Astro.props;
const ownerId = user?.id;
const { todayLima } = getLimaDateTime();

// Fechas de rango para el mes en curso (Lima)
const [anioActual, mesNum, diaDelMes] = todayLima.split('-').map(Number);
const mesActual = mesNum - 1;
const inicioMesStr = `${anioActual}-${String(mesActual + 1).padStart(2, '0')}-01`;
const ultimoDiaMes = new Date(Date.UTC(anioActual, mesActual + 1, 0)).getUTCDate();
const finMesStr = `${anioActual}-${String(mesActual + 1).padStart(2, '0')}-${String(ultimoDiaMes).padStart(2, '0')}`;

let allBarberos: any[] = [];
let allServicios: any[] = [];
let allCitas: any[] = [];
let allBloqueos: any[] = [];
let cierresHistoricos: any[] = [];
let historialGeneralClientes: any[] = [];
let configBarberia: any = {
  whatsapp_soporte: '51999999999',
  bloques_lv: ['16:30', '17:40', '18:50', '20:00', '21:10'],
  bloques_sd: ['15:00', '16:10', '17:20', '19:00'],
  max_dias_reserva: 8,
};

try {
  const [barberosRes, serviciosRes, citasRes, bloqueosRes, cierresRes, cfgRes, histRes] = await Promise.all([
    supabaseAdmin
      .from('perfiles_staff')
      .select('id, nombre_visible, rol, activo, atiende_cortes')
      .in('rol', ['barber', 'owner'])
      .eq('activo', true)
      .order('rol', { ascending: false })
      .order('nombre_visible', { ascending: true }),
    supabaseAdmin
      .from('servicios')
      .select('id, nombre, precio, descripcion, activo')
      .eq('activo', true)
      .order('id', { ascending: true }),
    supabaseAdmin
      .from('citas')
      .select('id, barbero_id, dni, nombre_completo, telefono, servicio_id, precio_pactado, fecha, bloque_horario, estado, metodo_pago, created_at, servicios (nombre), perfiles_staff:barbero_id (nombre_visible)')
      .gte('fecha', inicioMesStr)
      .order('fecha', { ascending: true })
      .order('bloque_horario', { ascending: true }),
    supabaseAdmin
      .from('bloqueos_agenda')
      .select('id, barbero_id, fecha, bloque_horario, motivo, created_at, perfiles_staff:barbero_id (nombre_visible)')
      .gte('fecha', todayLima)
      .order('fecha', { ascending: true }),
    supabaseAdmin
      .from('cierres_mensuales')
      .select('*')
      .order('mes_anio', { ascending: false }),
    supabaseAdmin
      .from('configuracion_barberia')
      .select('*')
      .eq('id', 1)
      .maybeSingle(),
    supabaseAdmin
      .from('historial_clientes')
      .select('*')
      .order('ultima_fecha', { ascending: false }),
  ]);

  allBarberos = barberosRes.data || [];
  allServicios = serviciosRes.data || [];
  allCitas = citasRes.data || [];
  allBloqueos = bloqueosRes.data || [];
  cierresHistoricos = cierresRes.data || [];
  historialGeneralClientes = histRes.data || [];
  if (cfgRes.data) configBarberia = { ...configBarberia, ...cfgRes.data };
} catch (e) {
  console.error('Error cargando datos del panel gerencial:', e);
}

// Combinar historial_clientes con citas actuales en caso de que falte alguno
if (historialGeneralClientes.length === 0 && allCitas.length > 0) {
  const mapC = new Map<string, any>();
  for (const c of allCitas) {
    const prev = mapC.get(c.dni) || {
      dni: c.dni,
      nombre_completo: c.nombre_completo,
      telefono: c.telefono,
      total_agendadas: 0,
      total_asistidas: 0,
      total_canceladas: 0,
      ultima_fecha: c.fecha,
    };
    prev.nombre_completo = c.nombre_completo;
    prev.telefono = c.telefono;
    prev.total_agendadas += 1;
    if (c.estado === 'completada') prev.total_asistidas += 1;
    if (c.estado === 'cancelada' || c.estado === 'no_asistio') prev.total_canceladas += 1;
    if (c.fecha > prev.ultima_fecha) prev.ultima_fecha = c.fecha;
    mapC.set(c.dni, prev);
  }
  historialGeneralClientes = Array.from(mapC.values());
}

const whatsappSoporte = configBarberia.whatsapp_soporte || '51999999999';

// 1. KPIs Financieros en Vivo (Solo Efectivo y Yape / Plin)
const citasCompletadasMes = allCitas.filter(
  (c) => c.fecha >= inicioMesStr && c.fecha <= finMesStr && c.estado === 'completada'
);

const ingresosTotalesMes = citasCompletadasMes.reduce(
  (acc, c) => acc + Number(c.precio_pactado || 0),
  0
);

const semanasTranscurridas = Math.max(1, Math.ceil(diaDelMes / 7));
const promedioSemanal = (ingresosTotalesMes / semanasTranscurridas).toFixed(2);

const totalCerradas = allCitas.filter((c) =>
  ['completada', 'cancelada', 'no_asistio'].includes(c.estado)
).length;
const tasaFiabilidad =
  totalCerradas > 0
    ? ((citasCompletadasMes.length / totalCerradas) * 100).toFixed(1)
    : '100.0';

const totalEfectivo = citasCompletadasMes
  .filter((c) => (c.metodo_pago || 'efectivo') === 'efectivo')
  .reduce((acc, c) => acc + Number(c.precio_pactado || 0), 0);
const totalYapePlin = citasCompletadasMes
  .filter((c) => c.metodo_pago === 'yape_plin')
  .reduce((acc, c) => acc + Number(c.precio_pactado || 0), 0);

// 2. Rendimiento por Trabajador (Barberos + Gerencia)
const rendimientoBarberos = allBarberos.map((barbero) => {
  const citasBarbero = allCitas.filter((c) => c.barbero_id === barbero.id);
  const completadas = citasBarbero.filter((c) => c.estado === 'completada');
  const canceladasOFaltas = citasBarbero.filter((c) =>
    ['cancelada', 'no_asistio'].includes(c.estado)
  );
  const pendientesHoy = citasBarbero.filter((c) =>
    ['pendiente', 'aceptada'].includes(c.estado)
  );
  const recaudado = completadas.reduce((sum, c) => sum + Number(c.precio_pactado || 0), 0);

  return {
    id: barbero.id,
    nombre: barbero.nombre_visible,
    rol: barbero.rol,
    esGerente: barbero.id === ownerId || barbero.rol === 'owner',
    cortesCompletados: completadas.length,
    enAgenda: pendientesHoy.length,
    cancelaciones: canceladasOFaltas.length,
    totalGenerado: recaudado,
  };
});

// 3. Generar los 8 días de rango (Hoy + 7 días) anclados a Lima
const diasNombres = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
const mesesNombres = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

const dias8Rango = Array.from({ length: 8 }, (_, i) => {
  const d = new Date(`${todayLima}T12:00:00Z`);
  d.setUTCDate(d.getUTCDate() + i);
  const iso = d.toISOString().split('T')[0];
  const dow = d.getUTCDay();
  const esFinDeSemana = dow === 0 || dow === 6;
  const bloquesDia: string[] = esFinDeSemana
    ? (configBarberia.bloques_sd || ['15:00', '16:10', '17:20', '19:00'])
    : (configBarberia.bloques_lv || ['16:30', '17:40', '18:50', '20:00', '21:10']);
  return {
    iso,
    etiqueta: i === 0 ? 'HOY' : i === 1 ? 'MAÑ' : diasNombres[dow].toUpperCase(),
    diaSemana: diasNombres[dow],
    numero: String(d.getUTCDate()).padStart(2, '0'),
    mes: mesesNombres[d.getUTCMonth()],
    esFinDeSemana,
    bloquesDia,
  };
});

function formatHora12(hhmm: string) {
  if (!hhmm || !hhmm.includes(':')) return hhmm;
  const [hStr, mStr] = hhmm.split(':');
  const h = parseInt(hStr, 10);
  const suffix = h >= 12 ? 'PM' : 'AM';
  const h12 = h % 12 || 12;
  return `${h12}:${mStr} ${suffix}`;
}

const linkWhatsappSoporte = `https://wa.me/${whatsappSoporte}?text=${encodeURIComponent(
  'Hola Soporte de Barbería Lucas, soy Gerencia y necesito apoyo con:'
)}`;
---

<Layout title="Gerencia | Barbería Lucas">
  <div class="min-h-screen bg-[#0B0B0E] text-[#F4F4F6] pb-20">
    <!-- HEADER COMPACTO CON MENÚ DESPLEGABLE DE APARTADOS -->
    <header class="sticky top-0 z-30 border-b border-[#23232C] bg-[#0B0B0E]/95 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-2 px-3.5 py-2.5 sm:px-6">
        <div class="flex items-center gap-2">
          <BrandLogo size="sm" variant="compact" />
          <span class="rounded-md border border-[#D4AF37]/40 bg-[#D4AF37]/15 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
            Gerencia
          </span>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2">
          <button
            type="button"
            id="open-owner-manual-book-btn"
            class="inline-flex min-h-[38px] items-center gap-1.5 rounded-xl bg-[#D4AF37] px-3 py-1.5 text-xs font-bold text-[#0B0B0E] shadow-md active:scale-95"
          >
            <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            <span>Agendar Cita</span>
          </button>

          <a
            href={linkWhatsappSoporte}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[38px] items-center gap-1 rounded-xl border border-[#D4AF37]/40 bg-[#D4AF37]/10 px-2.5 py-1.5 text-xs font-bold text-[#D4AF37] active:scale-95"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
            <span class="hidden sm:inline">Soporte</span>
          </a>

          <button
            type="button"
            id="owner-logout-btn"
            class="min-h-[38px] rounded-xl border border-[#23232C] bg-[#141419] px-3 py-1.5 text-xs font-semibold text-[#9A9AA6] hover:text-[#EF4444] active:scale-95"
          >
            Salir
          </button>
        </div>
      </div>

      <!-- SELECTOR DESPLEGABLE DE APARTADOS (OCUPA 1 SOLA LÍNEA COMPACTA) -->
      <div class="mx-auto max-w-7xl px-3.5 pb-2.5 sm:px-6">
        <div class="relative" id="owner-nav-dropdown-wrapper">
          <button
            type="button"
            id="owner-nav-dropdown-trigger"
            aria-expanded="false"
            class="flex min-h-[42px] w-full items-center justify-between gap-2 rounded-xl border border-[#D4AF37]/40 bg-[#141419] px-3.5 py-2 text-left text-xs font-bold text-[#F4F4F6] shadow-md transition-all hover:border-[#D4AF37]"
          >
            <span class="flex items-center gap-2">
              <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-[#D4AF37]/15 text-[#D4AF37]">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
              </span>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-[#9A9AA6]">Apartado:</span>
              <span id="owner-nav-current-label" class="text-xs font-bold text-[#D4AF37]">Calendario Día</span>
            </span>

            <span class="flex items-center gap-1.5 text-[11px] font-semibold text-[#9A9AA6]">
              <span>Cambiar</span>
              <svg id="owner-nav-chevron" class="h-4 w-4 text-[#D4AF37] transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </span>
          </button>

          <!-- MENÚ DESPLEGABLE FLOTANTE -->
          <div
            id="owner-nav-dropdown-menu"
            class="absolute left-0 right-0 top-full z-40 mt-1.5 hidden rounded-2xl border border-[#D4AF37]/40 bg-[#141419] p-1.5 shadow-2xl"
          >
            <button
              type="button"
              data-spa-target="panel-calendario"
              data-spa-label="Calendario Día"
              class="spa-tab-btn flex min-h-[42px] w-full items-center justify-between rounded-xl bg-[#D4AF37] px-3.5 py-2 text-xs font-bold text-[#0B0B0E] transition-all"
            >
              <span class="flex items-center gap-2.5">
                <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                <span>Calendario de Cortes por Día</span>
              </span>
              <span class="font-mono text-[10px] uppercase">8 Días</span>
            </button>

            <button
              type="button"
              data-spa-target="panel-agenda"
              data-spa-label={`Citas (${allCitas.length})`}
              class="spa-tab-btn mt-1 flex min-h-[42px] w-full items-center justify-between rounded-xl px-3.5 py-2 text-xs font-bold text-[#F4F4F6] hover:bg-[#0B0B0E] transition-all"
            >
              <span class="flex items-center gap-2.5">
                <svg class="h-4 w-4 shrink-0 text-[#D4AF37]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                </svg>
                <span>Cuadrícula de Citas</span>
              </span>
              <span class="rounded-md bg-[#0B0B0E] px-2 py-0.5 font-mono text-[11px] text-[#D4AF37]">{allCitas.length}</span>
            </button>

            <button
              type="button"
              data-spa-target="panel-clientes"
              data-spa-label={`Clientes (${historialGeneralClientes.length})`}
              class="spa-tab-btn mt-1 flex min-h-[42px] w-full items-center justify-between rounded-xl px-3.5 py-2 text-xs font-bold text-[#F4F4F6] hover:bg-[#0B0B0E] transition-all"
            >
              <span class="flex items-center gap-2.5">
                <svg class="h-4 w-4 shrink-0 text-[#D4AF37]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                <span>Historial de Clientes</span>
              </span>
              <span class="rounded-md bg-[#0B0B0E] px-2 py-0.5 font-mono text-[11px] text-[#D4AF37]">{historialGeneralClientes.length}</span>
            </button>

            <button
              type="button"
              data-spa-target="panel-bloqueos"
              data-spa-label={`Descansos (${allBloqueos.length})`}
              class="spa-tab-btn mt-1 flex min-h-[42px] w-full items-center justify-between rounded-xl px-3.5 py-2 text-xs font-bold text-[#F4F4F6] hover:bg-[#0B0B0E] transition-all"
            >
              <span class="flex items-center gap-2.5">
                <svg class="h-4 w-4 shrink-0 text-[#D4AF37]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                </svg>
                <span>Bloquear Día y Descansos</span>
              </span>
              <span class="rounded-md bg-[#0B0B0E] px-2 py-0.5 font-mono text-[11px] text-[#D4AF37]">{allBloqueos.length}</span>
            </button>

            <button
              type="button"
              data-spa-target="panel-resumen"
              data-spa-label="Finanzas y Rendimiento"
              class="spa-tab-btn mt-1 flex min-h-[42px] w-full items-center justify-between rounded-xl px-3.5 py-2 text-xs font-bold text-[#F4F4F6] hover:bg-[#0B0B0E] transition-all"
            >
              <span class="flex items-center gap-2.5">
                <svg class="h-4 w-4 shrink-0 text-[#D4AF37]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 20V10M18 20V4M6 20v-4"/>
                </svg>
                <span>Finanzas y Rendimiento</span>
              </span>
              <span class="rounded-md bg-[#0B0B0E] px-2 py-0.5 font-mono text-[11px] text-[#10B981]">S/ {ingresosTotalesMes.toFixed(0)}</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-3.5 py-5 sm:px-6">

      <!-- =================================================================== -->
      <!-- PANEL 1: CALENDARIO DE CORTES POR DÍA (GENERAL Y POR TRABAJADOR)    -->
      <!-- =================================================================== -->
      <section id="panel-calendario" class="spa-panel space-y-5">
        <div class="rounded-2xl border border-[#23232C] bg-[#141419] p-4 sm:p-6">
          <div class="mb-4">
            <h2 class="font-serif text-lg font-bold text-[#F4F4F6] sm:text-xl">Calendario de Cortes por Día</h2>
            <p class="text-xs text-[#9A9AA6]">
              Toca cualquier día y filtra entre la vista general o cada trabajador para ver y gestionar sus turnos.
            </p>
          </div>

          <!-- PASO A: SELECTOR TÁCTIL DE LOS 8 DÍAS -->
          <div class="mb-5">
            <span class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
              1. Selecciona el Día
            </span>
            <div class="grid grid-cols-4 gap-2 sm:grid-cols-8">
              {dias8Rango.map((d, idx) => (
                <button
                  type="button"
                  data-cal-date={d.iso}
                  class={`cal-day-btn flex flex-col items-center justify-center rounded-xl border py-2.5 px-1 text-center transition-all active:scale-95 ${
                    idx === 0
                      ? 'border-[#D4AF37] bg-[#D4AF37]/15 text-[#F4F4F6] shadow-[0_0_15px_rgba(212,175,55,0.18)]'
                      : 'border-[#23232C] bg-[#0B0B0E] text-[#9A9AA6]'
                  }`}
                >
                  <span class="text-[9px] font-bold uppercase">{d.etiqueta}</span>
                  <span class="mt-0.5 font-mono text-base font-bold text-[#F4F4F6]">{d.numero}</span>
                  <span class="text-[10px]">{d.mes}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- PASO B: SELECTOR TÁCTIL DE TRABAJADOR (GENERAL O POR BARBERO) -->
          <div class="mb-5">
            <span class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
              2. Ver Agenda de:
            </span>
            <div class="flex flex-wrap gap-2">
              <button
                type="button"
                data-cal-worker="TODOS"
                class="cal-worker-btn min-h-[42px] rounded-xl bg-[#D4AF37] px-4 py-2 text-xs font-bold text-[#0B0B0E] shadow-sm transition-all"
              >
                General (Todos)
              </button>
              {allBarberos.map((b) => (
                <button
                  type="button"
                  data-cal-worker={b.id}
                  class="cal-worker-btn min-h-[42px] rounded-xl border border-[#23232C] bg-[#0B0B0E] px-4 py-2 text-xs font-bold text-[#F4F4F6] transition-all hover:border-[#D4AF37]/50"
                >
                  {b.id === ownerId || b.rol === 'owner' ? `${b.nombre_visible} (Mi Sillón)` : b.nombre_visible}
                </button>
              ))}
            </div>
          </div>

          <!-- MATRIZ VISUAL DE TURNOS POR DÍA Y POR TRABAJADOR -->
          {dias8Rango.map((d, dIdx) => (
            <div
              data-cal-day-panel={d.iso}
              class={`cal-day-panel space-y-6 ${dIdx === 0 ? '' : 'hidden'}`}
            >
              {allBarberos.map((barbero) => {
                const diaCerradoCompleto = allBloqueos.some(
                  (bl) => bl.barbero_id === barbero.id && bl.fecha === d.iso && bl.bloque_horario === 'TODOS'
                );

                return (
                  <div
                    data-cal-worker-section={barbero.id}
                    class="cal-worker-section rounded-2xl border border-[#23232C] bg-[#0B0B0E] p-4 sm:p-5"
                  >
                    <div class="mb-3.5 flex flex-wrap items-center justify-between gap-2 border-b border-[#23232C] pb-3">
                      <div class="flex items-center gap-2.5">
                        <div class="flex h-9 w-9 items-center justify-center rounded-full border border-[#D4AF37]/50 bg-[#141419] font-serif text-xs font-bold text-[#D4AF37]">
                          {barbero.nombre_visible.slice(0, 2).toUpperCase()}
                        </div>
                        <div>
                          <h3 class="font-serif text-sm font-bold text-[#F4F4F6] sm:text-base">
                            {barbero.nombre_visible}
                            {(barbero.id === ownerId || barbero.rol === 'owner') && (
                              <span class="ml-1.5 rounded bg-[#D4AF37]/15 px-2 py-0.5 font-sans text-[10px] font-bold text-[#D4AF37]">
                                Gerencia
                              </span>
                            )}
                          </h3>
                          <p class="font-mono text-[11px] text-[#9A9AA6]">
                            {d.diaSemana} {d.numero} {d.mes} ({d.iso})
                          </p>
                        </div>
                      </div>

                      {diaCerradoCompleto && (
                        <span class="rounded-lg border border-[#EF4444]/40 bg-[#EF4444]/15 px-3 py-1 text-xs font-bold text-[#EF4444]">
                          Día Completo Bloqueado
                        </span>
                      )}
                    </div>

                    <!-- Cuadrícula de Horas del Día para este Trabajador -->
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                      {d.bloquesDia.map((hora) => {
                        const citaSlot = allCitas.find(
                          (c) =>
                            c.barbero_id === barbero.id &&
                            c.fecha === d.iso &&
                            c.bloque_horario === hora &&
                            ['pendiente', 'aceptada', 'completada'].includes(c.estado)
                        );
                        const bloqueoSlot = allBloqueos.find(
                          (bl) =>
                            bl.barbero_id === barbero.id &&
                            bl.fecha === d.iso &&
                            (bl.bloque_horario === hora || bl.bloque_horario === 'TODOS')
                        );

                        if (citaSlot) {
                          const telClean = String(citaSlot.telefono || '').replace(/\D/g, '');
                          const waUrl = `https://wa.me/${telClean.startsWith('51') ? telClean : '51' + telClean}?text=${encodeURIComponent(`Hola ${citaSlot.nombre_completo}, te escribimos de Barbería Lucas sobre tu turno de las ${formatHora12(hora)} (${d.iso}).`)}`;
                          const primerNombre = String(citaSlot.nombre_completo || 'amigo').trim().split(' ')[0];
                          const msg30m = `¡Qué tal ${primerNombre}! Habla ${nombreVisible} de Barbería Lucas mano. Te paso la voz que en una media hora te toca tu turno (${formatHora12(hora)}). Ya te tengo la silla lista, avísame si ya estás en camino!`;
                          const waAviso30mUrl = `https://wa.me/${telClean.startsWith('51') ? telClean : '51' + telClean}?text=${encodeURIComponent(msg30m)}`;
                          const pagoTag = citaSlot.metodo_pago === 'yape_plin' ? 'Yape / Plin' : 'Efectivo';

                          return (
                            <div class="flex flex-col justify-between rounded-xl border border-[#D4AF37]/50 bg-[#141419] p-3.5 shadow-md">
                              <div>
                                <div class="flex items-center justify-between gap-2">
                                  <span class="font-mono text-sm font-bold text-[#D4AF37]">
                                    {formatHora12(hora)}
