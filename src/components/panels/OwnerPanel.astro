            </div>

            <!-- Filtros Táctiles -->
            <div class="flex flex-wrap gap-1.5">
              <button type="button" class="owner-filter-btn min-h-[38px] rounded-xl bg-[#D4AF37] px-3.5 py-1.5 text-xs font-bold text-[#0B0B0E]" data-estado="todos">
