      <section id="panel-bloqueos" class="spa-panel hidden space-y-6">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <div class="rounded-2xl border border-[#23232C] bg-[#141419] p-4 sm:p-6 lg:col-span-7">
            <h2 class="font-serif text-lg font-bold text-[#F4F4F6]">Bloquear Día o Descanso</h2>
            <p class="mt-1 text-xs text-[#9A9AA6]">
              Toca las tarjetas para bloquear un día o turno. Para desbloquearlo posteriormente, se solicita a Soporte.
            </p>

            <form id="owner-block-form" class="mt-5 space-y-5">
              <!-- 1. Selección Táctil de Barbero -->
              <div>
                <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
                  1. ¿A quién deseas bloquear el horario?
                </label>
                <input type="hidden" id="block-barbero-input" value="TODOS_BARBEROS" />
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                  <button
                    type="button"
                    data-block-barber="TODOS_BARBEROS"
                    class="owner-block-barber-card col-span-2 sm:col-span-1 min-h-[46px] rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 p-3 text-xs font-bold text-[#D4AF37] transition-all"
                  >
                    Toda la Barbería
                  </button>
                  {allBarberos.map((b) => (
                    <button
                      type="button"
                      data-block-barber={b.id}
                      class="owner-block-barber-card min-h-[46px] rounded-xl border border-[#23232C] bg-[#0B0B0E] p-3 text-xs font-bold text-[#F4F4F6] transition-all"
                    >
                      {b.nombre_visible}
                    </button>
                  ))}
                </div>
              </div>

              <!-- 2. Selección Táctil de Día (8 días) -->
              <div>
                <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
                  2. Elige el Día (Rango 8 días)
                </label>
                <input type="hidden" id="block-fecha-input" value={todayLima} />
                <div class="grid grid-cols-4 gap-2 sm:grid-cols-8">
                  {dias8Rango.map((d, idx) => (
                    <button
                      type="button"
                      data-block-date={d.iso}
                      data-weekend={d.esFinDeSemana ? '1' : '0'}
                      class={`owner-block-date-btn flex flex-col items-center rounded-xl border py-2.5 px-1 text-center transition-all ${
                        idx === 0
                          ? 'border-[#D4AF37] bg-[#D4AF37]/15 text-[#F4F4F6]'
                          : 'border-[#23232C] bg-[#0B0B0E] text-[#9A9AA6]'
                      }`}
                    >
                      <span class="text-[9px] font-bold uppercase">{d.etiqueta}</span>
                      <span class="font-mono text-sm font-bold text-[#F4F4F6]">{d.numero}</span>
                      <span class="text-[9px]">{d.mes}</span>
                    </button>
                  ))}
                </div>
              </div>

              <!-- 3. Selección Táctil de Día Completo o Turno -->
              <div>
                <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
                  3. Elige Día Completo o Hora de Descanso
                </label>
                <input type="hidden" id="block-horario-input" value="TODOS" />
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-3" id="owner-block-slots-grid"></div>
              </div>

              <!-- 4. Motivo Rápido con Botones + Texto -->
              <div>
                <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
                  4. Motivo del Bloqueo
                </label>
                <div class="mb-2 flex flex-wrap gap-2">
                  {['Descanso', 'Almuerzo', 'Feriado', 'Diligencia'].map((mot) => (
                    <button
                      type="button"
                      data-motivo-preset={mot}
                      class="motivo-preset-btn rounded-lg border border-[#23232C] bg-[#0B0B0E] px-3 py-1.5 text-xs font-semibold text-[#9A9AA6] hover:border-[#D4AF37] hover:text-[#D4AF37]"
                    >
                      {mot}
                    </button>
                  ))}
                </div>
                <input
                  type="text"
                  id="block-motivo-input"
                  value="Descanso"
                  class="w-full rounded-xl border border-[#23232C] bg-[#0B0B0E] px-3.5 py-3 text-xs text-[#F4F4F6] focus:border-[#D4AF37] focus:outline-none"
                />
              </div>

              <div id="owner-block-feedback" class="hidden rounded-xl border px-4 py-2.5 text-xs"></div>

              <button
                type="submit"
                id="owner-block-submit-btn"
                class="min-h-[48px] w-full rounded-xl bg-[#D4AF37] py-3.5 text-xs font-bold uppercase tracking-wider text-[#0B0B0E] shadow-lg active:scale-[0.99]"
              >
                Confirmar Bloqueo
              </button>
            </form>
          </div>

          <!-- Cuadrícula de Bloqueos Activos -->
          <div class="rounded-2xl border border-[#23232C] bg-[#141419] p-4 sm:p-6 lg:col-span-5">
            <h3 class="mb-4 font-serif text-base font-bold text-[#F4F4F6]">
              Bloqueos Activos ({allBloqueos.length})
            </h3>

            {allBloqueos.length === 0 ? (
              <div class="rounded-xl border border-[#23232C] bg-[#0B0B0E] p-8 text-center text-xs text-[#9A9AA6]">
                No hay días ni horarios bloqueados.
              </div>
            ) : (
              <div class="grid grid-cols-1 gap-3">
                {allBloqueos.map((b) => (
                  <div class="flex flex-col justify-between gap-3 rounded-xl border border-[#23232C] bg-[#0B0B0E] p-4 sm:flex-row sm:items-center">
                    <div>
                      <span class="rounded bg-[#D4AF37]/15 px-2 py-0.5 font-mono text-[10px] font-bold text-[#D4AF37]">
                        {b.fecha} • {b.bloque_horario === 'TODOS' ? 'DÍA COMPLETO' : formatHora12(b.bloque_horario)}
                      </span>
                      <p class="mt-1 font-serif text-sm font-bold text-[#F4F4F6]">
                        {b.perfiles_staff?.nombre_visible || 'Barbero'}
                      </p>
                      <p class="text-xs text-[#9A9AA6]">{b.motivo || 'Descanso'}</p>
                    </div>
                    <a
                      href={`https://wa.me/${whatsappSoporte}?text=${encodeURIComponent(`Hola Soporte, solicito desbloquear el horario de ${b.perfiles_staff?.nombre_visible || 'Barbero'} del día ${b.fecha} (${b.bloque_horario}).`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex min-h-[38px] shrink-0 items-center justify-center rounded-xl border border-[#D4AF37]/40 bg-[#D4AF37]/10 px-3 py-2 text-xs font-bold text-[#D4AF37]"
                    >
                      Pedir Desbloqueo
                    </a>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- =================================================================== -->
      <!-- PANEL 5: FINANZAS EN VIVO Y RENDIMIENTO                             -->
      <!-- =================================================================== -->
      <section id="panel-resumen" class="spa-panel hidden space-y-6">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-2xl border border-[#D4AF37]/40 bg-[#141419] p-5">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#9A9AA6]">Ingresos del Mes</span>
            <p class="mt-2 font-mono text-2xl font-bold text-[#D4AF37] sm:text-3xl">
              S/ {ingresosTotalesMes.toFixed(2)}
            </p>
            <p class="mt-1 text-xs text-[#9A9AA6]">{citasCompletadasMes.length} cortes completados</p>
          </div>

          <div class="rounded-2xl border border-[#23232C] bg-[#141419] p-5">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#9A9AA6]">Promedio Semanal</span>
            <p class="mt-2 font-mono text-2xl font-bold text-[#F4F4F6] sm:text-3xl">
              S/ {promedioSemanal}
            </p>
            <p class="mt-1 text-xs text-[#9A9AA6]">Semana {semanasTranscurridas} del mes</p>
          </div>

          <div class="rounded-2xl border border-[#23232C] bg-[#141419] p-5">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#9A9AA6]">Fiabilidad</span>
            <p class="mt-2 font-mono text-2xl font-bold text-[#10B981] sm:text-3xl">
              {tasaFiabilidad}%
            </p>
            <p class="mt-1 text-xs text-[#9A9AA6]">Asistencia efectiva</p>
          </div>

          <div class="rounded-2xl border border-[#23232C] bg-[#141419] p-5">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#9A9AA6]">Medios de Pago</span>
            <div class="mt-3 space-y-2 text-xs">
              <div class="flex justify-between">
                <span>Efectivo:</span>
                <strong class="font-mono text-[#F4F4F6]">S/ {totalEfectivo.toFixed(2)}</strong>
              </div>
              <div class="flex justify-between">
                <span>Yape / Plin:</span>
                <strong class="font-mono text-[#D4AF37]">S/ {totalYapePlin.toFixed(2)}</strong>
              </div>
            </div>
          </div>
        </div>

        <!-- Rendimiento por Trabajador en Cuadrados Responsivos -->
        <div class="rounded-2xl border border-[#23232C] bg-[#141419] p-4 sm:p-6">
          <h2 class="mb-4 font-serif text-lg font-bold text-[#F4F4F6]">Rendimiento por Trabajador</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {rendimientoBarberos.map((b) => (
              <div class="rounded-2xl border border-[#23232C] bg-[#0B0B0E] p-4">
                <div class="flex items-center justify-between border-b border-[#23232C] pb-3">
                  <div>
                    <h3 class="font-serif text-base font-bold text-[#F4F4F6]">{b.nombre}</h3>
                    <span class="text-[10px] font-bold uppercase text-[#D4AF37]">
                      {b.esGerente ? 'Gerencia y Barbero' : 'Barbero'}
                    </span>
                  </div>
                  <span class="font-mono text-lg font-bold text-[#D4AF37]">
                    S/ {b.totalGenerado.toFixed(2)}
                  </span>
                </div>
                <div class="mt-3 grid grid-cols-3 gap-2 text-center text-xs">
                  <div class="rounded-xl bg-[#141419] p-2.5">
                    <span class="block font-mono text-base font-bold text-[#10B981]">{b.cortesCompletados}</span>
                    <span class="text-[10px] text-[#9A9AA6]">Completados</span>
                  </div>
                  <div class="rounded-xl bg-[#141419] p-2.5">
                    <span class="block font-mono text-base font-bold text-[#D4AF37]">{b.enAgenda}</span>
                    <span class="text-[10px] text-[#9A9AA6]">En Agenda</span>
                  </div>
                  <div class="rounded-xl bg-[#141419] p-2.5">
                    <span class="block font-mono text-base font-bold text-[#EF4444]">{b.cancelaciones}</span>
                    <span class="text-[10px] text-[#9A9AA6]">Faltas/Canc.</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

    </main>
  </div>

  <!-- =================================================================== -->
  <!-- MODAL TÁCTIL: AGENDAR CITA MANUAL (GERENCIA)                        -->
  <!-- =================================================================== -->
  <div id="owner-manual-book-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm">
    <div class="max-h-[92vh] w-full max-w-lg overflow-y-auto rounded-2xl border border-[#23232C] bg-[#141419] p-5 shadow-2xl">
      <div class="mb-4 flex items-center justify-between border-b border-[#23232C] pb-3">
        <div>
          <h3 class="font-serif text-base font-bold text-[#F4F4F6]">Agendar Cita Directa</h3>
          <p class="text-xs text-[#D4AF37]">Registra el turno de un cliente para cualquier barbero</p>
        </div>
        <button type="button" id="close-owner-manual-book" class="rounded-lg p-2 text-[#9A9AA6] hover:text-[#F4F4F6]" aria-label="Cerrar">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <form id="owner-manual-book-form" class="space-y-4">
        <input type="hidden" id="omb-barbero-id" value={allBarberos[0]?.id || ''} />
        <input type="hidden" id="omb-servicio-id" value={allServicios[0]?.id || 1} />
        <input type="hidden" id="omb-fecha" value={todayLima} />
        <input type="hidden" id="omb-bloque" value="" />
        <input type="hidden" id="omb-pago" value="efectivo" />

        <!-- 1. Seleccionar Barbero -->
        <div>
          <label class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
            1. Elige el Barbero
          </label>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
            {allBarberos.map((b, idx) => (
              <button
                type="button"
                data-omb-barber={b.id}
                class={`omb-barber-card min-h-[42px] rounded-xl border p-2.5 text-xs font-bold transition-all ${
                  idx === 0
                    ? 'border-[#D4AF37] bg-[#D4AF37]/15 text-[#D4AF37]'
                    : 'border-[#23232C] bg-[#0B0B0E] text-[#F4F4F6]'
                }`}
              >
                {b.nombre_visible}
              </button>
            ))}
          </div>
        </div>

        <!-- 2. Seleccionar Servicio -->
        <div>
          <label class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
            2. Servicio
          </label>
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
            {allServicios.map((s, idx) => (
              <button
                type="button"
                data-omb-srv={s.id}
                class={`omb-srv-card rounded-xl border p-2.5 text-left transition-all ${
                  idx === 0
                    ? 'border-[#D4AF37] bg-[#D4AF37]/15 text-[#F4F4F6]'
                    : 'border-[#23232C] bg-[#0B0B0E] text-[#9A9AA6]'
                }`}
              >
                <span class="block text-xs font-bold text-[#F4F4F6]">{s.nombre}</span>
                <span class="font-mono text-xs font-bold text-[#D4AF37]">S/ {Number(s.precio).toFixed(2)}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- 3. Seleccionar Día (8 días) -->
        <div>
          <label class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
            3. Día (Rango 8 días)
          </label>
          <div class="grid grid-cols-4 gap-1.5 sm:grid-cols-8">
            {dias8Rango.map((d, idx) => (
              <button
                type="button"
                data-omb-date={d.iso}
                class={`omb-date-card flex flex-col items-center rounded-xl border py-2 px-1 text-center ${
                  idx === 0
                    ? 'border-[#D4AF37] bg-[#D4AF37]/15 text-[#F4F4F6]'
                    : 'border-[#23232C] bg-[#0B0B0E] text-[#9A9AA6]'
                }`}
              >
                <span class="text-[8px] font-bold uppercase">{d.etiqueta}</span>
                <span class="font-mono text-xs font-bold text-[#F4F4F6]">{d.numero}</span>
                <span class="text-[8px]">{d.mes}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- 4. Seleccionar Hora -->
        <div>
          <label class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
            4. Horario Disponible
          </label>
          <div id="omb-slots-container" class="grid grid-cols-3 gap-2"></div>
        </div>

        <!-- 5. Datos del Cliente -->
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label class="mb-1 block text-[10px] font-bold uppercase text-[#9A9AA6]">DNI (8 dígitos)</label>
            <input
              type="text"
              id="omb-dni"
              required
              maxlength="8"
              pattern="[0-9]{8}"
              inputmode="numeric"
              placeholder="Ej: 71234567"
              class="w-full rounded-xl border border-[#23232C] bg-[#0B0B0E] px-3.5 py-2.5 font-mono text-xs text-[#F4F4F6]"
            />
          </div>
          <div>
            <label class="mb-1 block text-[10px] font-bold uppercase text-[#9A9AA6]">WhatsApp / Celular</label>
            <input
              type="tel"
              id="omb-telefono"
              required
              maxlength="15"
              inputmode="tel"
              placeholder="Ej: 987654321"
              class="w-full rounded-xl border border-[#23232C] bg-[#0B0B0E] px-3.5 py-2.5 font-mono text-xs text-[#F4F4F6]"
            />
          </div>
        </div>

        <div>
          <label class="mb-1 block text-[10px] font-bold uppercase text-[#9A9AA6]">Nombre Completo del Cliente</label>
          <input
            type="text"
            id="omb-nombre"
            required
            placeholder="Ej: Carlos Mendoza"
            class="w-full rounded-xl border border-[#23232C] bg-[#0B0B0E] px-3.5 py-2.5 text-xs text-[#F4F4F6]"
          />
        </div>

        <!-- 6. Método de Pago (Solo Efectivo y Yape / Plin) -->
        <div>
          <label class="mb-1.5 block text-[10px] font-bold uppercase text-[#D4AF37]">Método de Pago</label>
          <div class="grid grid-cols-2 gap-2">
            <button
              type="button"
              data-omb-pay="efectivo"
              class="omb-pay-card min-h-[40px] rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 py-2 text-xs font-bold text-[#D4AF37]"
            >
              Efectivo
            </button>
            <button
              type="button"
              data-omb-pay="yape_plin"
              class="omb-pay-card min-h-[40px] rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2 text-xs font-bold text-[#F4F4F6]"
            >
              Yape / Plin
            </button>
          </div>
        </div>

        <div id="omb-feedback" class="hidden rounded-xl border px-3.5 py-2.5 text-xs"></div>

        <button
          type="submit"
          class="min-h-[46px] w-full rounded-xl bg-[#D4AF37] py-3 text-xs font-bold uppercase tracking-wider text-[#0B0B0E] shadow-lg"
        >
          Confirmar y Agendar Cita
        </button>
      </form>
    </div>
  </div>

  <!-- =================================================================== -->
  <!-- MODAL TÁCTIL PARA REPROGRAMAR / CAMBIAR BARBERO                     -->
  <!-- =================================================================== -->
  <div id="reassign-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm">
    <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-2xl border border-[#23232C] bg-[#141419] p-5 shadow-2xl">
      <div class="mb-4 flex items-center justify-between border-b border-[#23232C] pb-3">
        <div>
          <h3 class="font-serif text-base font-bold text-[#F4F4F6]">Reprogramar Turno</h3>
          <p id="reassign-client-label" class="text-xs text-[#D4AF37]"></p>
        </div>
        <button type="button" id="close-reassign-modal" class="rounded-lg p-2 text-[#9A9AA6] hover:text-[#F4F4F6]" aria-label="Cerrar">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <form id="reassign-form" class="space-y-4">
        <input type="hidden" id="reassign-cita-id" />
        <input type="hidden" id="reassign-barbero" />
        <input type="hidden" id="reassign-fecha" value={todayLima} />
        <input type="hidden" id="reassign-bloque" value="" />

        <!-- 1. Selección Táctil de Barbero -->
        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
            1. Elige el Barbero
          </label>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
            {allBarberos.map((b) => (
              <button
                type="button"
                data-modal-barber={b.id}
                class="modal-barber-card min-h-[44px] rounded-xl border border-[#23232C] bg-[#0B0B0E] p-2.5 text-xs font-bold text-[#F4F4F6] transition-all"
              >
                {b.nombre_visible}
              </button>
            ))}
          </div>
        </div>

        <!-- 2. Selección Táctil de Fecha (8 días) -->
        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
            2. Elige Nueva Fecha (Rango 8 días)
          </label>
          <div class="grid grid-cols-4 gap-1.5 sm:grid-cols-8">
            {dias8Rango.map((d) => (
              <button
                type="button"
                data-modal-date={d.iso}
                class="modal-date-card flex flex-col items-center rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2 px-1 text-center text-[#9A9AA6]"
              >
                <span class="text-[8px] font-bold uppercase">{d.etiqueta}</span>
                <span class="font-mono text-xs font-bold text-[#F4F4F6]">{d.numero}</span>
                <span class="text-[8px]">{d.mes}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- 3. Selección Táctil de Hora -->
        <div>
          <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]">
            3. Elige Nuevo Horario
          </label>
          <div id="modal-slots-container" class="grid grid-cols-3 gap-2"></div>
        </div>

        <div id="reassign-feedback" class="hidden rounded-xl border px-3.5 py-2.5 text-xs"></div>

        <div class="grid grid-cols-2 gap-2 pt-2">
          <button type="button" id="cancel-reassign-btn" class="min-h-[44px] rounded-xl border border-[#23232C] bg-[#0B0B0E] text-xs font-bold text-[#9A9AA6]">
            Cancelar
          </button>
          <button type="submit" class="min-h-[44px] rounded-xl bg-[#D4AF37] text-xs font-bold uppercase text-[#0B0B0E]">
            Guardar Cambios
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script define:vars={{ bloquesLv: configBarberia.bloques_lv, bloquesSd: configBarberia.bloques_sd }}>
  function format12h(hhmm) {
    if (!hhmm || !hhmm.includes(':')) return hhmm;
    const [hStr, mStr] = hhmm.split(':');
    const h = parseInt(hStr, 10);
    const suffix = h >= 12 ? 'PM' : 'AM';
    const h12 = h % 12 || 12;
    return `${h12}:${mStr} ${suffix}`;
  }

  // 1. NAVEGACIÓN SPA CON MENÚ DESPLEGABLE Y PERSISTENCIA EN SESSIONSTORAGE
  const tabBtns = document.querySelectorAll('.spa-tab-btn');
  const panels = document.querySelectorAll('.spa-panel');
  const navDropdownWrapper = document.getElementById('owner-nav-dropdown-wrapper');
  const navDropdownTrigger = document.getElementById('owner-nav-dropdown-trigger');
  const navDropdownMenu = document.getElementById('owner-nav-dropdown-menu');
  const navCurrentLabel = document.getElementById('owner-nav-current-label');
  const navChevron = document.getElementById('owner-nav-chevron');

  let isOwnerDropdownOpen = false;

  function openOwnerDropdown() {
    if (!navDropdownMenu) return;
    isOwnerDropdownOpen = true;
    navDropdownMenu.classList.remove('hidden');
    navDropdownMenu.classList.remove('nav-dropdown-closing');
    navDropdownMenu.classList.add('nav-dropdown-opening');
    navDropdownTrigger?.setAttribute('aria-expanded', 'true');
    navChevron?.classList.add('rotate-180');
  }

  function closeOwnerDropdown() {
    if (!navDropdownMenu || !isOwnerDropdownOpen) return;
    isOwnerDropdownOpen = false;
    navDropdownMenu.classList.remove('nav-dropdown-opening');
    navDropdownMenu.classList.add('nav-dropdown-closing');
    navDropdownTrigger?.setAttribute('aria-expanded', 'false');
    navChevron?.classList.remove('rotate-180');
    setTimeout(() => {
      if (!isOwnerDropdownOpen) {
        navDropdownMenu.classList.add('hidden');
        navDropdownMenu.classList.remove('nav-dropdown-closing');
      }
    }, 160);
  }

  navDropdownTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!isOwnerDropdownOpen) {
      openOwnerDropdown();
    } else {
      closeOwnerDropdown();
    }
  });

  document.addEventListener('click', (e) => {
    if (navDropdownWrapper && !navDropdownWrapper.contains(e.target)) {
      closeOwnerDropdown();
    }
  });

  function activateOwnerTab(targetId) {
    if (!targetId) return;
    tabBtns.forEach((b, idx) => {
      const mtClass = idx === 0 ? '' : 'mt-1 ';
      if (b.getAttribute('data-spa-target') === targetId) {
        b.className = `${mtClass}spa-tab-btn flex min-h-[42px] w-full items-center justify-between rounded-xl bg-[#D4AF37] px-3.5 py-2 text-xs font-bold text-[#0B0B0E] transition-all`;
        if (navCurrentLabel) {
          navCurrentLabel.textContent = b.getAttribute('data-spa-label') || 'Calendario Día';
        }
      } else {
        b.className = `${mtClass}spa-tab-btn flex min-h-[42px] w-full items-center justify-between rounded-xl px-3.5 py-2 text-xs font-bold text-[#F4F4F6] hover:bg-[#0B0B0E] transition-all`;
      }
    });
    panels.forEach((p) => {
      if (p.id === targetId) p.classList.remove('hidden');
      else p.classList.add('hidden');
    });
    sessionStorage.setItem('owner_active_tab', targetId);
    closeOwnerDropdown();
  }

  const savedOwnerTab = sessionStorage.getItem('owner_active_tab');
  if (savedOwnerTab && document.getElementById(savedOwnerTab)) {
    activateOwnerTab(savedOwnerTab);
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activateOwnerTab(btn.getAttribute('data-spa-target'));
    });
  });

  // 2. LOGOUT
  document.getElementById('owner-logout-btn')?.addEventListener('click', async () => {
    sessionStorage.clear();
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.reload();
  });

  // 3. CALENDARIO DE CORTES POR DÍA Y POR TRABAJADOR (CON PERSISTENCIA)
  const calDayBtns = document.querySelectorAll('.cal-day-btn');
  const calDayPanels = document.querySelectorAll('.cal-day-panel');

  function activateOwnerCalDay(iso) {
    if (!iso) return;
    calDayBtns.forEach((b) => {
      if (b.getAttribute('data-cal-date') === iso) {
        b.className = 'cal-day-btn flex flex-col items-center justify-center rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 py-2.5 px-1 text-center text-[#F4F4F6] shadow-[0_0_15px_rgba(212,175,55,0.18)] transition-all active:scale-95';
      } else {
        b.className = 'cal-day-btn flex flex-col items-center justify-center rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2.5 px-1 text-center text-[#9A9AA6] transition-all active:scale-95';
      }
    });
    calDayPanels.forEach((p) => {
      if (p.getAttribute('data-cal-day-panel') === iso) p.classList.remove('hidden');
      else p.classList.add('hidden');
    });
    sessionStorage.setItem('owner_cal_day', iso);
  }

  const savedOwnerCalDay = sessionStorage.getItem('owner_cal_day');
  if (savedOwnerCalDay && document.querySelector(`[data-cal-day-panel="${savedOwnerCalDay}"]`)) {
    activateOwnerCalDay(savedOwnerCalDay);
  }

  calDayBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activateOwnerCalDay(btn.getAttribute('data-cal-date'));
    });
  });

  const calWorkerBtns = document.querySelectorAll('.cal-worker-btn');
  const calWorkerSections = document.querySelectorAll('.cal-worker-section');

  function activateOwnerCalWorker(wId) {
    if (!wId) return;
    calWorkerBtns.forEach((b) => {
      if (b.getAttribute('data-cal-worker') === wId) {
        b.className = 'cal-worker-btn min-h-[42px] rounded-xl bg-[#D4AF37] px-4 py-2 text-xs font-bold text-[#0B0B0E] shadow-sm transition-all';
      } else {
        b.className = 'cal-worker-btn min-h-[42px] rounded-xl border border-[#23232C] bg-[#0B0B0E] px-4 py-2 text-xs font-bold text-[#F4F4F6] transition-all hover:border-[#D4AF37]/50';
      }
    });
    calWorkerSections.forEach((sec) => {
      if (wId === 'TODOS' || sec.getAttribute('data-cal-worker-section') === wId) {
        sec.classList.remove('hidden');
      } else {
        sec.classList.add('hidden');
      }
    });
    sessionStorage.setItem('owner_cal_worker', wId);
  }

  const savedOwnerCalWorker = sessionStorage.getItem('owner_cal_worker');
  if (savedOwnerCalWorker) {
    activateOwnerCalWorker(savedOwnerCalWorker);
  }

  calWorkerBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activateOwnerCalWorker(btn.getAttribute('data-cal-worker'));
    });
  });

  // Botón rápido para bloquear un turno libre desde el calendario
  document.querySelectorAll('.quick-block-slot-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const barbero_id = btn.getAttribute('data-barbero-id');
      const fecha = btn.getAttribute('data-fecha');
      const bloque_horario = btn.getAttribute('data-bloque');
      const res = await fetch('/api/owner/gestion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          accion: 'bloquear_horario',
          barbero_id,
          fecha,
          bloque_horario,
          motivo: 'Descanso',
        }),
      });
      if (res.ok) {
        window.location.reload();
      } else {
        const data = await res.json();
        alert(data.error || 'Error al bloquear turno');
      }
    });
  });

  // 4. BOTONES TÁCTILES DE CAMBIO DE ESTADO (APROBAR, COMPLETAR, RECHAZAR, NO ASISTIÓ)
  document.querySelectorAll('.owner-status-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const citaId = btn.getAttribute('data-cita-id');
      const nuevoEstado = btn.getAttribute('data-estado');
      const res = await fetch('/api/owner/gestion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ accion: 'cambiar_estado', cita_id: citaId, nuevo_estado: nuevoEstado }),
      });
      if (res.ok) {
        window.location.reload();
      } else {
        const data = await res.json();
        alert(data.error || 'Error al cambiar estado');
      }
    });
  });

  // 5. FILTRO DE CUADRÍCULA DE CITAS (CON PERSISTENCIA)
  const filterBtns = document.querySelectorAll('.owner-filter-btn');
  const citaCards = document.querySelectorAll('.owner-cita-card');

  function applyOwnerCitaFilter(est) {
    if (!est) return;
    filterBtns.forEach((b) => {
      if (b.getAttribute('data-estado') === est) {
        b.className = 'owner-filter-btn min-h-[38px] rounded-xl bg-[#D4AF37] px-3.5 py-1.5 text-xs font-bold text-[#0B0B0E]';
      } else {
        b.className = 'owner-filter-btn min-h-[38px] rounded-xl border border-[#23232C] bg-[#0B0B0E] px-3.5 py-1.5 text-xs font-semibold text-[#9A9AA6]';
      }
