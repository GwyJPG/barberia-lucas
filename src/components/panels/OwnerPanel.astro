  document.querySelectorAll('.modal-date-card').forEach((card) => {
    card.addEventListener('click', () => {
      const iso = card.getAttribute('data-modal-date') || '';
      reassignFecha.value = iso;
      highlightModalDate(iso);
      loadModalSlots();
    });
  });

  const closeReassign = () => {
    reassignModal?.classList.add('hidden');
    reassignModal?.classList.remove('flex');
