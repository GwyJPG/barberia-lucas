                            {cl.total_agendadas}
                          </span>
                          <span class="text-[10px] font-semibold uppercase text-[#9A9AA6]">
                            Agendadas
                          </span>
                        </div>
                        <div class="rounded-xl border border-[#10B981]/30 bg-[#10B981]/10 p-2.5">
                          <span class="block font-mono text-lg font-bold text-[#10B981]">
                            {cl.total_asistidas}
                          </span>
                          <span class="text-[10px] font-semibold uppercase text-[#10B981]">
                            Asistieron
                          </span>
                        </div>
                        <div class="rounded-xl border border-[#EF4444]/30 bg-[#EF4444]/10 p-2.5">
                          <span class="block font-mono text-lg font-bold text-[#EF4444]">
                            {cl.total_canceladas}
                          </span>
                          <span class="text-[10px] font-semibold uppercase text-[#EF4444]">
                            Cancelaron
                          </span>
                        </div>
                      </div>
                    </div>

                    <a
                      href={waUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex min-h-[40px] w-full items-center justify-center rounded-xl border border-[#10B981]/40 bg-[#10B981]/10 px-3 py-2 text-xs font-bold text-[#10B981]"
                    >
                      Contactar por WhatsApp
                    </a>
                  </div>
