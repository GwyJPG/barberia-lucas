                                Pedir Desbloqueo a Soporte
                              </a>
                            </div>
                          );
                        }

                        return (
                          <div class="flex flex-col justify-between rounded-xl border border-[#23232C] bg-[#141419]/40 p-3.5">
                            <div class="flex items-center justify-between">
                              <span class="font-mono text-sm font-bold text-[#F4F4F6]">
                                {formatHora12(hora)}
                              </span>
                              <span class="rounded-md bg-[#10B981]/15 px-2 py-0.5 text-[10px] font-bold uppercase text-[#10B981]">
                                Disponible
                              </span>
                            </div>
                            <p class="my-2 text-xs text-[#9A9AA6]">Turno libre para reserva</p>
                            <button
                              type="button"
                              class="quick-block-slot-btn min-h-[36px] rounded-lg border border-[#23232C] bg-[#0B0B0E] px-3 py-1.5 text-[11px] font-semibold text-[#9A9AA6] hover:border-[#D4AF37] hover:text-[#D4AF37] active:scale-95"
                              data-barbero-id={barbero.id}
                              data-fecha={d.iso}
                              data-bloque={hora}
                            >
                              Bloquear este turno
                            </button>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                );
              })}
            </div>
          ))}
        </div>
      </section>

      <!-- =================================================================== -->
      <!-- PANEL 2: CUADRÍCULA DE CITAS CON BOTONES TÁCTILES                   -->
      <!-- =================================================================== -->
      <section id="panel-agenda" class="spa-panel hidden space-y-5">
        <div class="rounded-2xl border border-[#23232C] bg-[#141419] p-4 sm:p-6">
