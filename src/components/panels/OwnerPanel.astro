                          data-barbero-id={cita.barbero_id}
                          data-fecha={cita.fecha}
                          data-bloque={cita.bloque_horario}
                          data-cliente={cita.nombre_completo}
                        >
                          <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                          <span>Reprogramar</span>
                        </button>
                        {cita.estado !== 'cancelada' && (
                          <button
                            type="button"
                            class="owner-status-btn inline-flex min-h-[42px] items-center justify-center gap-1.5 rounded-xl border border-[#EF4444]/40 bg-[#EF4444]/10 px-3 py-2 text-xs font-bold text-[#EF4444] active:scale-95"
                            data-cita-id={cita.id}
                            data-estado="cancelada"
                          >
                            <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            <span>Rechazar</span>
                          </button>
                        )}
                      </div>

                      <div class="grid grid-cols-2 gap-2">
                        <button
                          type="button"
                          class="owner-status-btn min-h-[38px] rounded-xl border border-[#23232C] bg-[#141419] px-3 py-1.5 text-[11px] font-semibold text-[#9A9AA6] hover:text-[#F4F4F6]"
                          data-cita-id={cita.id}
                          data-estado="no_asistio"
                        >
                          Marcar No Asistió
                        </button>
                        <a
                          href={waClientUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex min-h-[38px] items-center justify-center rounded-xl border border-[#10B981]/40 bg-[#10B981]/10 px-3 py-1.5 text-xs font-bold text-[#10B981]"
                        >
                          WhatsApp Cliente
                        </a>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          )}
        </div>
      </section>

      <!-- =================================================================== -->
      <!-- PANEL 3: HISTORIAL Y SEGUIMIENTO DE CLIENTES (PERMANENTE)           -->
