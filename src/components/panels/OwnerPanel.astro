  const savedOwnerFilter = sessionStorage.getItem('owner_citas_filter');
  if (savedOwnerFilter) {
    applyOwnerCitaFilter(savedOwnerFilter);
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      applyOwnerCitaFilter(btn.getAttribute('data-estado'));
