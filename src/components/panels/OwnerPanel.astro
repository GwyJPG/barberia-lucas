  document.getElementById('close-reassign-modal')?.addEventListener('click', closeReassign);
  document.getElementById('cancel-reassign-btn')?.addEventListener('click', closeReassign);

  document.getElementById('reassign-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const res = await fetch('/api/owner/gestion', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        accion: 'reasignar_o_reagendar',
        cita_id: reassignCitaId.value,
        nuevo_barbero_id: reassignBarbero.value,
        nueva_fecha: reassignFecha.value,
        nuevo_bloque: reassignBloque.value,
      }),
    });
    const data = await res.json();
    if (!res.ok || !data.exito) {
      if (reassignFeedback) {
        reassignFeedback.className = 'rounded-xl border border-[#EF4444]/40 bg-[#EF4444]/10 px-3.5 py-2.5 text-xs text-[#EF4444]';
        reassignFeedback.textContent = data.error || 'Error al reprogramar.';
        reassignFeedback.classList.remove('hidden');
      }
      return;
    }
    window.location.reload();
  });

  // 8. BLOQUEAR DÍA O DESCANSOS
  const blockBarberoInput = document.getElementById('block-barbero-input');
  const blockFechaInput = document.getElementById('block-fecha-input');
  const blockHorarioInput = document.getElementById('block-horario-input');
  const blockMotivoInput = document.getElementById('block-motivo-input');
  const blockSlotsGrid = document.getElementById('owner-block-slots-grid');

  document.querySelectorAll('.owner-block-barber-card').forEach((card) => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.owner-block-barber-card').forEach((c) => {
        const isTodos = c.getAttribute('data-block-barber') === 'TODOS_BARBEROS';
        c.className = `owner-block-barber-card ${isTodos ? 'col-span-2 sm:col-span-1 ' : ''}min-h-[46px] rounded-xl border border-[#23232C] bg-[#0B0B0E] p-3 text-xs font-bold text-[#F4F4F6] transition-all`;
      });
      const isCardTodos = card.getAttribute('data-block-barber') === 'TODOS_BARBEROS';
      card.className = `owner-block-barber-card ${isCardTodos ? 'col-span-2 sm:col-span-1 ' : ''}min-h-[46px] rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 p-3 text-xs font-bold text-[#D4AF37] transition-all`;
      if (blockBarberoInput) blockBarberoInput.value = card.getAttribute('data-block-barber') || 'TODOS_BARBEROS';
    });
  });

  document.querySelectorAll('.motivo-preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (blockMotivoInput) blockMotivoInput.value = btn.getAttribute('data-motivo-preset') || 'Descanso';
    });
  });

  function renderBlockSlots(isWeekend) {
    if (!blockSlotsGrid) return;
    const slots = isWeekend ? (bloquesSd || ['15:00', '16:10', '17:20', '19:00']) : (bloquesLv || ['16:30', '17:40', '18:50', '20:00', '21:10']);
    if (blockHorarioInput) blockHorarioInput.value = 'TODOS';
    blockSlotsGrid.innerHTML = '';

    const options = [{ val: 'TODOS', label: 'Día Completo (Cerrado)' }, ...slots.map((s) => ({ val: s, label: `Turno ${format12h(s)}` }))];
    options.forEach((opt, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = i === 0
        ? 'owner-block-slot-pill col-span-2 sm:col-span-3 min-h-[42px] rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 py-2.5 px-3 text-xs font-bold text-[#D4AF37]'
        : 'owner-block-slot-pill min-h-[42px] rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2.5 px-3 font-mono text-xs text-[#F4F4F6]';
      btn.textContent = opt.label;
      btn.addEventListener('click', () => {
        document.querySelectorAll('.owner-block-slot-pill').forEach((b, idx) => {
          b.className = idx === 0
            ? 'owner-block-slot-pill col-span-2 sm:col-span-3 min-h-[42px] rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2.5 px-3 text-xs font-bold text-[#9A9AA6]'
            : 'owner-block-slot-pill min-h-[42px] rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2.5 px-3 font-mono text-xs text-[#9A9AA6]';
        });
        btn.className = i === 0
          ? 'owner-block-slot-pill col-span-2 sm:col-span-3 min-h-[42px] rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 py-2.5 px-3 text-xs font-bold text-[#D4AF37]'
          : 'owner-block-slot-pill min-h-[42px] rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 py-2.5 px-3 font-mono text-xs font-bold text-[#D4AF37]';
        if (blockHorarioInput) blockHorarioInput.value = opt.val;
      });
      blockSlotsGrid.appendChild(btn);
    });
  }

  document.querySelectorAll('.owner-block-date-btn').forEach((btn, idx) => {
    if (idx === 0) renderBlockSlots(btn.getAttribute('data-weekend') === '1');
    btn.addEventListener('click', () => {
      document.querySelectorAll('.owner-block-date-btn').forEach((b) => {
        b.className = 'owner-block-date-btn flex flex-col items-center rounded-xl border border-[#23232C] bg-[#0B0B0E] py-2.5 px-1 text-center text-[#9A9AA6]';
      });
      btn.className = 'owner-block-date-btn flex flex-col items-center rounded-xl border border-[#D4AF37] bg-[#D4AF37]/15 py-2.5 px-1 text-center text-[#F4F4F6]';
      if (blockFechaInput) blockFechaInput.value = btn.getAttribute('data-block-date') || '';
      renderBlockSlots(btn.getAttribute('data-weekend') === '1');
    });
  });

  document.getElementById('owner-block-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fb = document.getElementById('owner-block-feedback');
    const submitBtn = document.getElementById('owner-block-submit-btn');
    const barbero_id = blockBarberoInput?.value;
    const fecha = blockFechaInput?.value;
    const bloque_horario = blockHorarioInput?.value;
    const motivo = blockMotivoInput?.value;

    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.textContent = 'Bloqueando...';
    }

    try {
      const res = await fetch('/api/owner/gestion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ accion: 'bloquear_horario', barbero_id, fecha, bloque_horario, motivo }),
      });
      const data = await res.json();
      if (!res.ok || !data.exito) {
        if (fb) {
          fb.className = 'rounded-xl border border-[#EF4444]/40 bg-[#EF4444]/10 px-4 py-2.5 text-xs text-[#EF4444]';
          fb.textContent = data.error || 'Error al bloquear.';
          fb.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.textContent = 'Confirmar Bloqueo';
        }
        return;
      }
      window.location.reload();
    } catch (err) {
      if (fb) {
        fb.className = 'rounded-xl border border-[#EF4444]/40 bg-[#EF4444]/10 px-4 py-2.5 text-xs text-[#EF4444]';
        fb.textContent = 'Error de conexión al procesar el bloqueo.';
        fb.classList.remove('hidden');
      }
      if (submitBtn) {
        submitBtn.removeAttribute('disabled');
        submitBtn.textContent = 'Confirmar Bloqueo';
      }
    }
  });
</script>
