            </div>
          ) : (
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {allCitas.map((cita) => {
                const waClean = String(cita.telefono || '').replace(/\D/g, '');
                const waClientUrl = `https://wa.me/${waClean.startsWith('51') ? waClean : '51' + waClean}?text=${encodeURIComponent(`Hola ${cita.nombre_completo}, te escribimos de Barbería Lucas sobre tu turno del ${cita.fecha} a las ${formatHora12(cita.bloque_horario)}.`)}`;
                const pagoTag = cita.metodo_pago === 'yape_plin' ? 'Yape / Plin' : 'Efectivo';

                return (
                  <article
                    class="owner-cita-card flex flex-col justify-between rounded-2xl border border-[#23232C] bg-[#0B0B0E] p-4 shadow-lg transition-all hover:border-[#D4AF37]/40"
                    data-estado={cita.estado}
                  >
                    <div>
                      <!-- Cabecera del Cuadrado -->
                      <div class="flex items-center justify-between gap-2 border-b border-[#23232C] pb-3">
                        <div>
                          <span class="block font-mono text-xs font-bold text-[#D4AF37]">
                            {cita.fecha} • {formatHora12(cita.bloque_horario)}
                          </span>
                          <span class="text-[11px] font-semibold text-[#9A9AA6]">
                            Barbero: <strong class="text-[#F4F4F6]">{cita.perfiles_staff?.nombre_visible || 'Barbero'}</strong>
                          </span>
                        </div>

                        <span class={`rounded-lg px-2.5 py-1 text-[10px] font-bold uppercase ${
                          cita.estado === 'completada'
                            ? 'bg-[#10B981]/20 text-[#10B981]'
                            : cita.estado === 'aceptada'
                            ? 'bg-[#D4AF37]/20 text-[#D4AF37]'
                            : cita.estado === 'pendiente'
                            ? 'bg-[#F59E0B]/20 text-[#F59E0B]'
                            : 'bg-[#EF4444]/20 text-[#EF4444]'
                        }`}>
                          {cita.estado === 'no_asistio' ? 'No Asistió' : cita.estado}
                        </span>
                      </div>

                      <!-- Datos del Cliente y Servicio -->
                      <div class="my-3.5 space-y-1.5">
                        <h3 class="font-serif text-base font-bold text-[#F4F4F6]">
                          {cita.nombre_completo}
                        </h3>
                        <p class="font-mono text-xs text-[#9A9AA6]">
                          DNI: {cita.dni} • Cel: {cita.telefono}
                        </p>
                        <div class="mt-2 flex items-center justify-between rounded-xl border border-[#23232C] bg-[#141419] px-3 py-2 text-xs">
                          <span class="font-semibold text-[#F4F4F6]">{cita.servicios?.nombre || 'Corte'}</span>
                          <span class="font-mono font-bold text-[#D4AF37]">
                            S/ {Number(cita.precio_pactado).toFixed(2)} ({pagoTag})
                          </span>
                        </div>
                      </div>
                    </div>

                    <!-- BOTONES GRANDES DE ACCIÓN -->
                    <div class="space-y-2 border-t border-[#23232C] pt-3">
                      <div class="grid grid-cols-2 gap-2">
                        {cita.estado !== 'aceptada' && cita.estado !== 'completada' && (
                          <button
                            type="button"
                            class="owner-status-btn inline-flex min-h-[42px] items-center justify-center gap-1.5 rounded-xl bg-[#D4AF37] px-3 py-2 text-xs font-bold text-[#0B0B0E] active:scale-95"
                            data-cita-id={cita.id}
                            data-estado="aceptada"
                          >
                            <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>Aprobar</span>
                          </button>
                        )}
                        {cita.estado !== 'completada' && (
                          <button
                            type="button"
                            class="owner-status-btn inline-flex min-h-[42px] items-center justify-center gap-1.5 rounded-xl bg-[#10B981] px-3 py-2 text-xs font-bold text-[#0B0B0E] active:scale-95"
                            data-cita-id={cita.id}
                            data-estado="completada"
                          >
                            <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>Completar</span>
                          </button>
                        )}
                        <button
                          type="button"
                          class="open-reassign-btn inline-flex min-h-[42px] items-center justify-center gap-1.5 rounded-xl border border-[#D4AF37]/40 bg-[#D4AF37]/10 px-3 py-2 text-xs font-bold text-[#D4AF37] active:scale-95"
