              </button>
              <button type="button" class="owner-filter-btn min-h-[38px] rounded-xl border border-[#23232C] bg-[#0B0B0E] px-3.5 py-1.5 text-xs font-semibold text-[#9A9AA6]" data-estado="pendiente">
                Pendientes
              </button>
              <button type="button" class="owner-filter-btn min-h-[38px] rounded-xl border border-[#23232C] bg-[#0B0B0E] px-3.5 py-1.5 text-xs font-semibold text-[#9A9AA6]" data-estado="aceptada">
                Aprobadas
              </button>
              <button type="button" class="owner-filter-btn min-h-[38px] rounded-xl border border-[#23232C] bg-[#0B0B0E] px-3.5 py-1.5 text-xs font-semibold text-[#9A9AA6]" data-estado="completada">
                Completadas
              </button>
            </div>
          </div>

          {allCitas.length === 0 ? (
            <div class="rounded-2xl border border-[#23232C] bg-[#0B0B0E] p-10 text-center text-sm text-[#9A9AA6]">
