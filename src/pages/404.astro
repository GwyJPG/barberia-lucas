---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import BrandLogo from '../components/brand/BrandLogo.astro';

Astro.response.status = 404;
---

<Layout title="404 • Página No Encontrada | Barbería Lucas">
  <div class="flex min-h-screen flex-col justify-between bg-[#0B0B0E] text-[#F4F4F6]">
    <header class="border-b border-[#23232C] bg-[#0B0B0E]/95">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6">
        <a href="/" aria-label="Volver a Barbería Lucas">
          <BrandLogo size="sm" />
        </a>
        <a
          href="/"
          class="rounded-xl border border-[#23232C] bg-[#141419] px-3.5 py-2 text-xs font-semibold text-[#9A9AA6] hover:border-[#D4AF37] hover:text-[#D4AF37] transition-all"
        >
          Inicio
        </a>
      </div>
    </header>

    <main class="mx-auto flex max-w-md flex-col items-center justify-center px-4 py-16 text-center">
      <span class="font-mono text-5xl font-bold tracking-tight text-[#D4AF37]/80 sm:text-6xl">
        404
      </span>

      <h1 class="mt-4 font-serif text-2xl font-bold text-[#F4F4F6]">
        Página no encontrada
      </h1>

      <p class="mt-2 text-xs text-[#9A9AA6] leading-relaxed">
        El enlace que intentas abrir no existe o ha sido movido.
      </p>

      <div class="mt-7">
        <a
          href="/"
          class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-xl bg-[#D4AF37] px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-[#0B0B0E] shadow-md hover:bg-[#D4AF37]/90 active:scale-95 transition-all"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          <span>Volver a la Barbería</span>
        </a>
      </div>
    </main>

    <footer class="border-t border-[#23232C] py-5 text-center text-xs text-[#9A9AA6]">
      © {new Date().getFullYear()} Barbería Lucas
    </footer>
  </div>
</Layout>
