---
import Layout from '../layouts/Layout.astro';
import BrandLogo from '../components/brand/BrandLogo.astro';

Astro.response.status = 404;
---

<Layout title="404 • Página No Encontrada | Barbería Lucas">
  <div class="flex min-h-screen flex-col justify-between bg-[#0B0B0E] text-[#F4F4F6]">
    <!-- Header simple -->
    <header class="border-b border-[#23232C] bg-[#0B0B0E]/95">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
        <a href="/" aria-label="Volver al inicio">
          <BrandLogo size="sm" />
        </a>
        <a
          href="/"
          class="rounded-lg border border-[#23232C] bg-[#141419] px-3.5 py-2 text-xs font-semibold text-[#F4F4F6] transition-colors hover:border-[#D4AF37] hover:text-[#D4AF37]"
        >
          Ir al Inicio
        </a>
      </div>
    </header>

    <!-- Contenido central 404 -->
    <main class="mx-auto flex max-w-lg flex-col items-center justify-center px-4 py-16 text-center">
      <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-2xl border border-[#D4AF37]/40 bg-[#141419] text-[#D4AF37] shadow-[0_0_30px_rgba(212,175,55,0.15)]">
        <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="6" cy="6" r="3"></circle>
          <circle cx="6" cy="18" r="3"></circle>
          <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
          <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
          <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
        </svg>
      </div>

      <span class="rounded-full border border-[#D4AF37]/30 bg-[#D4AF37]/10 px-3.5 py-1 font-mono text-xs font-bold uppercase tracking-widest text-[#D4AF37]">
        Error 404
      </span>

      <h1 class="mt-4 font-serif text-3xl font-bold tracking-tight text-[#F4F4F6] sm:text-4xl">
        Página No Encontrada
      </h1>

      <p class="mt-3 text-sm leading-relaxed text-[#9A9AA6]">
        La dirección que ingresaste no existe, fue movida o requiere credenciales de acceso autorizadas.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="gold-shimmer inline-flex items-center gap-2 rounded-xl px-6 py-3.5 text-xs font-bold uppercase tracking-wider text-[#0B0B0E]"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>Volver a Reservar Turno</span>
        </a>
      </div>
    </main>

    <!-- Footer simple -->
    <footer class="border-t border-[#23232C] py-6 text-center text-xs text-[#9A9AA6]">
      © {new Date().getFullYear()} Barbería Lucas • Todos los derechos reservados
    </footer>
  </div>
</Layout>
